{
    "project": "Phase-Lock Semantic Firewall",
    "version": "v2.6.1",
    "active_features": {
        "dimensional_excitation_firewall": true,
        "realtime_noise_tolerance_ui": true,
        "local_rag_enabled": true,
        "ollama_integration": true,
        "async_pdf_vectorization": true,
        "hardware_telemetry_hud": true,
        "commander_tui_enabled": true,
        "document_manager_pack_deletion": true,
        "global_system_action_status": true,
        "utf8_ndjson_line_streaming": true,
        "explicit_firewall_chat_feedback": true,
        "language_agnostic_segmentation": true,
        "overflow_chunking_fallback": true,
        "query_segmentation_defense": true,
        "strict_context_prompting": true,
        "hybrid_adaptive_threshold_firewall": true,
        "cosine_similarity_gate": true,
        "reorderable_sequential_pipeline": true,
        "noise_prefilter_global_delta": true,
        "configurable_adaptive_factor": true,
        "atomic_config_state": true,
        "pydantic_schema_validation": true,
        "modular_firewall_engine": true,
        "cors_hardening": true,
        "opt_in_api_key_auth": true,
        "input_length_sanitization": true
    },
    "state_schema": {
        "excitation_threshold": {"type": "int", "default": 150, "range": [0, 1024]},
        "noise_tolerance": {"type": "float", "default": 0.005, "range": [0.001, 0.100]},
        "cosine_threshold": {"type": "float", "default": 0.78, "range": [0.50, 0.99]},
        "global_noise_limit": {"type": "float", "default": 0.50, "range": [0.10, 2.00]},
        "cosine_order": {"type": "int", "default": 2, "range": [1, 3]},
        "excitation_order": {"type": "int", "default": 3, "range": [1, 3]},
        "noise_order": {"type": "int", "default": 1, "range": [1, 3]},
        "adaptive_factor": {"type": "float", "default": 0.85, "range": [0.01, 1.00]}
    },
    "constraints": {
        "vector_dim": 1024
    }
}