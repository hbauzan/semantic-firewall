# Rompepepe — Independent Configuration
FIREWALL_API_BASE_URL=http://localhost:8000
FIREWALL_X_API_KEY=

# External Explorer LLM Configuration (pure httpx)
# Providers supported: google, anthropic, openai, ollama
EXPLORER_PROVIDER=google
EXPLORER_API_KEY=
EXPLORER_MODEL=gemini-3.1-flash-lite

# Rate limiting (RPM: Requests Per Minute) for Explorer LLM provider (default: 15 for Gemini text-out models)
EXPLORER_RPM_LIMIT=15

# Vault storage path for state, logs, and QA reports
VAULT_STORAGE_PATH=./vault
