# Three-Headed Semantic Firewall — Environment Configuration
# Copy to .env and adjust for your deployment.
# Both backend (pydantic-settings) and frontend (Vite) read from this single file.
# For local development, no .env is needed — all defaults work out of the box.

# ============================================================
# BACKEND
# ============================================================

# CORS: comma-separated list of allowed origins. Default: http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173

# API Key: optional. If set, /chat, /audit, and /galaxy/config endpoints
# require X-API-Key header. Leave commented for open local development.
# FIREWALL_API_KEY=your-secret-key-here

# Ollama: LLM inference endpoint and model.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Embedding model (HuggingFace ID). Change only if you reindex the corpus.
# EMBEDDING_MODEL=BAAI/bge-m3

# Optional TEI sidecar (L05). Default is in-process SentenceTransformer.
# Image digest is pinned in deploy/tei/docker-compose.yml — never tei:latest.
# TEI_ENABLED=false
# TEI_URL=http://127.0.0.1:8080
# TEI_IMAGE_DIGEST=sha256:2614a26fcdefcd4e8b2d1265cdfb8d0144b591fe7f7e9db922a38056f7c47ca2
# TEI_TIMEOUT_S=5.0

# PDF ingestion tuning.
# MAX_UPLOAD_MB=50
# CHUNK_SIZE=2048
# CHUNK_OVERLAP=200
# EMBEDDING_BATCH_SIZE=10

# RAG context depth: corpus chunks retrieved per clause (1–32).
# RAG_TOP_K=12

# Egress: chat = live token yield (default, today's HUD).
# compliance = full-response hold (CDE). Set via POST /galaxy/config
# {"egress_profile": "compliance"} — not an env flag.
# EGRESS is config state, not this file.

# Rate limiting (per client IP). Format: "N/period" (e.g. "30/minute", "5/second").
# RATE_LIMIT_CHAT=6000/minute
# RATE_LIMIT_DEFAULT=6000/minute
# RATE_LIMIT_UPLOAD=10/minute

# Server configuration.
# HOST=0.0.0.0
# PORT=8000
# RELOAD=false

# ============================================================
# FRONTEND (Vite only exposes variables prefixed with VITE_)
# ============================================================

# Backend API endpoint used by all frontend components.
# VITE_API_BASE_URL=http://localhost:8000
