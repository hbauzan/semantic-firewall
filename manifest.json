{
    "project": "Three-Headed Semantic Firewall",
    "version": "v2.34.0",
    "state_schema": {
        "excitation_threshold": {
            "type": "int",
            "default": 150,
            "range": [0, 1024]
        },
        "noise_tolerance": {
            "type": "float",
            "default": 0.015,
            "range": [0.0, 1.0],
            "alias": "coarse_delta_tolerance"
        },
        "cosine_threshold": {
            "type": "float",
            "default": 0.5315,
            "range": [0.0, 1.0]
        },
        "global_noise_limit": {
            "type": "float",
            "default": 4.5,
            "range": [0.0, 10.0]
        },
        "cosine_order": {
            "type": "int",
            "default": 1,
            "range": [1, 3]
        },
        "excitation_order": {
            "type": "int",
            "default": 2,
            "range": [1, 3]
        },
        "noise_order": {
            "type": "int",
            "default": 3,
            "range": [1, 3]
        },
        "adaptive_factor": {
            "type": "float",
            "default": 0.85,
            "range": [0.01, 1.0]
        },
        "noise_enabled": {
            "type": "bool",
            "default": true
        },
        "cosine_enabled": {
            "type": "bool",
            "default": true
        },
        "excitation_enabled": {
            "type": "bool",
            "default": true
        },
        "rag_top_k": {
            "type": "int",
            "default": 12,
            "range": [1, 32]
        },
        "firewall_mode": {
            "type": "str",
            "default": "positive",
            "values": ["positive", "negative"]
        },
        "active_tab": {
            "type": "str",
            "default": "chat",
            "description": "Last active UI tab. Persisted via _last_used profile."
        },
        "egress_profile": {
            "type": "str",
            "default": "chat",
            "values": ["chat", "compliance"],
            "description": "chat = live yield; compliance = full-response hold before any generation token."
        }
    },
    "constraints": {
        "vector_dim": 1024
    }
}
