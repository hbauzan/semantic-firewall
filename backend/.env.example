# Phase-Lock Semantic Firewall — Environment Configuration
# Copy to .env and adjust for your deployment.

# CORS: comma-separated list of allowed origins. Default: http://localhost:5173
# Set to * for development (credentials will be auto-disabled).
ALLOWED_ORIGINS=http://localhost:5173

# API Key: optional. If set, all /chat, /audit, and /config endpoints
# require X-API-Key header. Leave empty/unset for open local development.
# FIREWALL_API_KEY=your-secret-key-here
